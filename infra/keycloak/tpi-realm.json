{
  "realm": "tpi",
  "enabled": true,
  "accessTokenLifespan": 3600,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "USER", "description": "Usuario que puede operar en el mercado" },
      { "name": "ADMIN", "description": "Administrador que puede ver todas las transacciones" }
    ]
  },
  "clients": [
    {
      "clientId": "tpi-client",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": true,
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "fullScopeAllowed": true
    }
  ],
  "users": [
